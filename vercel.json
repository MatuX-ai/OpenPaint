{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm install --filter @openpaint/web... && pnpm --filter @openpaint/web build",
  "outputDirectory": "src-web/dist",
  "installCommand": "corepack enable && corepack prepare pnpm@8.15.0 --activate && pnpm install --filter @openpaint/web...",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
